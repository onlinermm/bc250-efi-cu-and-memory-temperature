#include <Uefi/UefiMultiPhase.h>
#include "../Include/GpuConfig.h"
#define EFI_HII_PLATFORM_SETUP_FORMSET_GUID {0x93039971,0x8545,0x4b04,{0xb4,0x5e,0x32,0xeb,0x83,0x26,0x04,0x0e}}
formset
 guid = BC250_GPU_FORMSET_GUID,
 title = STRING_TOKEN(STR_TITLE),
 help = STRING_TOKEN(STR_HELP),
 classguid = EFI_HII_PLATFORM_SETUP_FORMSET_GUID,
 varstore BC250_GPU_CONFIG,
   varid = BC250_GPU_STORE,
   name = Bc250GpuConfig,
   guid = BC250_GPU_VARIABLE_GUID;
 form formid = BC250_GPU_FORM,
   title = STRING_TOKEN(STR_TITLE);
   subtitle text = STRING_TOKEN(STR_GPU_SECTION);
   oneof varid = Bc250GpuConfig.Mode,
     questionid = BC250_GPU_MODE_QUESTION,
     prompt = STRING_TOKEN(STR_MODE),
     help = STRING_TOKEN(STR_MODE_HELP),
     flags = INTERACTIVE | RESET_REQUIRED,
     option text = STRING_TOKEN(STR_STOCK), value = 0, flags = DEFAULT | MANUFACTURING;
     option text = STRING_TOKEN(STR_ALL), value = 1, flags = 0;
     option text = STRING_TOKEN(STR_CUSTOM), value = 2, flags = 0;
   endoneof;
   text help = STRING_TOKEN(STR_MODE_HELP), text = STRING_TOKEN(STR_SUMMARY);
   grayoutif NOT ideqval Bc250GpuConfig.Mode == 2;
     goto BC250_GPU_CUSTOM_FORM,
       prompt = STRING_TOKEN(STR_EDIT), help = STRING_TOKEN(STR_EDIT_HELP);
   endif;
   subtitle text = STRING_TOKEN(STR_MEMORY_SECTION);
   subtitle text = STRING_TOKEN(STR_DEPENDENCY);
   oneof varid = Bc250GpuConfig.Temperature,
     questionid = BC250_TEMPERATURE_QUESTION,
     prompt = STRING_TOKEN(STR_TEMPERATURE),
     help = STRING_TOKEN(STR_TEMPERATURE_HELP),
     flags = INTERACTIVE | RESET_REQUIRED,
     option text = STRING_TOKEN(STR_DISABLED), value = 0, flags = DEFAULT | MANUFACTURING;
     option text = STRING_TOKEN(STR_ENABLED), value = 1, flags = 0;
   endoneof;
   subtitle text = STRING_TOKEN(STR_DEFAULTS);
   subtitle text = STRING_TOKEN(STR_NEXTBOOT);
 endform;
 form formid = BC250_GPU_CUSTOM_FORM,
   title = STRING_TOKEN(STR_EDIT);
   subtitle text = STRING_TOKEN(STR_PAIRS);
   subtitle text = STRING_TOKEN(STR_BANK_0);
   checkbox varid = Bc250GpuConfig.Wgp[0],
     questionid = 512,
     prompt = STRING_TOKEN(STR_WGP_0),
     help = STRING_TOKEN(STR_WGP_HELP),
     flags = INTERACTIVE | RESET_REQUIRED,
     default = 1,
   endcheckbox;
   checkbox varid = Bc250GpuConfig.Wgp[1],
     questionid = 513,
     prompt = STRING_TOKEN(STR_WGP_1),
     help = STRING_TOKEN(STR_WGP_HELP),
